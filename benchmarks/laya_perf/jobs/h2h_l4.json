[
 {
  "name": "trees",
  "print_log": 3000,
  "cmd": [
   "bash",
   "-c",
   "R=$(cd $S/../../.. && pwd); cd $R && git fetch -q origin laya-decision-best laya-decision-perf-rebased && for t in 't_pr 84db80f0a' 't_dh 12fcce54c' 't_ours origin/laya-decision-perf-rebased' 't_best origin/laya-decision-best' 't_bestns origin/laya-decision-best~1'; do set -- $t; [ -d $ROOT/$1 ] || git worktree add -q --detach $ROOT/$1 $2; echo \"LAYA_TREE $1 $(git -C $ROOT/$1 log -1 --format='%h %s')\"; done"
  ]
 },
 {
  "name": "h2h_full_A_pr_0",
  "env": {
   "TORCHINDUCTOR_CACHE_DIR": "$ROOT/ic_pr"
  },
  "cmd": [
