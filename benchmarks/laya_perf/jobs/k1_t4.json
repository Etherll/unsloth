 {
  "name": "official_A",
  "cmd": [
   "bash",
   "-c",
   "[ -d $ROOT/laya-official ] || (git clone -q https://github.com/NandhaKishorM/laya.git $ROOT/laya-official && git -C $ROOT/laya-official checkout -q 2e4d9c8); $PY $S/official_bench.py --mb 2 --acc 16 --steps 24 --out $ROOT/out/official_A.json"
  ],
  "out": "$ROOT/out/official_A.json"
 },
 {
  "name": "official_B",
  "cmd": [
   "bash",
   "-c",
   "[ -d $ROOT/laya-official ] || (git clone -q https://github.com/NandhaKishorM/laya.git $ROOT/laya-official && git -C $ROOT/laya-official checkout -q 2e4d9c8); $PY $S/official_bench.py --mb 8 --acc 8 --steps 16 --out $ROOT/out/official_B.json"
  ],
  "out": "$ROOT/out/official_B.json"
 },
 {
  "name": "prof_pr_full_A",
  "env": {
   "LP_LAYER_RANGES": "1"
  },
  "print_log": 6000,
  "cmd": [
   "bash",
   "-c",
   "$PY $S/bench.py --mode full --mb 2 --acc 16 --steps 9 --warmup 2 --tree $ROOT/base --prof $ROOT/out/prof_pr_full_A --out $ROOT/out/prof_pr_full_A.json > /dev/null 2>&1; $PY $S/prof.py $ROOT/out/prof_pr_full_A/trace.json; rm -f $ROOT/out/prof_pr_full_A/trace.json"
  ]
 },
 {
  "name": "prof_cand_full_A",
