[
 {
  "name": "pytest_perf",
  "cmd": [
   "$PY",
   "-m",
   "pytest",
   "tests/test_decision_model.py",
   "-q",
   "-p",
   "no:cacheprovider"
  ],
  "cwd": "$ROOT/perf",
  "print_log": 2500
 },
 {
  "name": "sdpa_probe",
  "cmd": [
   "$S/sdpa_probe.py",
   "--out",
   "$ROOT/out/sdpa_probe.json"
  ]
 },
 {
  "name": "g1_pr_full_fp32",
  "cmd": [
   "$S/parity.py",
   "--tree",
   "$ROOT/base",
   "--mode",
   "full",
   "--precision",
   "fp32",
   "--gc",
   "true",
   "--out",
   "$ROOT/out/g1_pr_full_fp32.json"
  ]
 },
