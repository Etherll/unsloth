[
 {
  "name": "stack_torch210",
  "print_log": 4000,
  "cmd": [
   "bash",
   "-c",
   "$PY -m pip install -q 'torch==2.10.0' 'torchvision==0.25.0' 'xformers==0.0.35' && ($PY -m pip uninstall -y -q torchaudio || true); $PY -c 'import torch, triton, xformers; print(\"LAYA_STACK torch\", torch.__version__, \"triton\", triton.__version__, \"xformers\", xformers.__version__)'; $PY -c 'import inspect; from torch.nn.attention.varlen import varlen_attn as f; print(\"LAYA_VARLEN\", inspect.signature(f))' || echo 'LAYA_VARLEN missing'; $PY -m xformers.info 2>&1 | grep -E 'memory_efficient_attention.(cutlassF|fa2F|fa3F|ckF)|pytorch.version|gpu.compute' | head -8"
  ]
 },
 {
  "name": "make_long",
  "cmd": [
   "$S/make_long.py"
  ]
 },
 {
  "name": "smoke_xf2",
  "env": {
   "LP_TORCH_LOGS": "1",
   "UNSLOTH_COMPILE_DISABLE": "1"
  },
  "cmd": [
   "$S/bench.py",
   "--data",
   "items.pt",
   "--mode",
   "full",
   "--mb",
   "2",
   "--acc",
   "4",
   "--steps",
   "4",
   "--tree",
   "$ROOT/perf",
   "--opts",
   "unpad_xf2",
   "--out",
   "$ROOT/out/smoke_xf2.json"
  ]
 },
