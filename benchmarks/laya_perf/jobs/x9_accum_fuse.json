   "-c",
   "$PY $S/bench.py --mode full --mb 2 --acc 16 --steps 9 --warmup 2 --tree $ROOT/perf --opts accum_fuse --prof $ROOT/out/prof_acc_full_A --out $ROOT/out/prof_acc_full_A.json > /dev/null 2>&1; $PY $S/prof.py $ROOT/out/prof_acc_full_A/trace.json; rm -f $ROOT/out/prof_acc_full_A/trace.json"
  ]
